# PostgreSQL (Prisma)
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/biodata

# MinIO object storage
MINIO_ENDPOINT=s3.example.com
MINIO_PORT=443
MINIO_USE_SSL=true
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=biodata
MINIO_PUBLIC_URL=https://s3.example.com

# Auth.js (NextAuth v5) - generate with: npx auth secret
AUTH_SECRET=
AUTH_TRUST_HOST=true
# Google OAuth credentials - create at https://console.cloud.google.com (see README)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Comma-separated Google account emails allowed into /admin
ADMIN_EMAILS=you@example.com
