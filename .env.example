# Firebase Web SDK config (public values — safe in the browser).
# Firebase Console → Project settings → General → Your apps → Web app → SDK config
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated Google emails allowed in the admin UI (mirror firestore.rules).
NEXT_PUBLIC_ADMIN_EMAILS=you@example.com
