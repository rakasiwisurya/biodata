rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ── Admin allowlist ───────────────────────────────────────────────
    // Only these Google accounts may write. This is the REAL security
    // boundary (client-side checks are only for UX). Keep this list in
    // sync with NEXT_PUBLIC_ADMIN_EMAILS in your environment.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'rakasiwi.surya@gmail.com',
          'rakasiwisurya12@gmail.com',
          'arcdigitalinnovation@gmail.com'
        ];
    }

    // Portfolio content: world-readable (it's a public CV), admin-writable.
    match /profile/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /skills/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /experiences/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /projects/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /education/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /certificates/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /socials/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
