generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Profile {
  id               String   @id @default("singleton")
  name             String
  headline         String
  heroDescription  String   @db.Text
  aboutDescription String   @db.Text
  avatarUrl        String?
  cvUrl            String?
  email            String
  phone            String?
  location         String?
  updatedAt        DateTime @updatedAt
}

model SocialLink {
  id       String @id @default(cuid())
  platform String
  url      String
  order    Int    @default(0)
}

enum SkillCategory {
  FRONTEND
  BACKEND
  DATABASE
  DEVOPS
  MOBILE
  OTHER
}

model Skill {
  id          String        @id @default(cuid())
  name        String
  category    SkillCategory
  proficiency Int           @default(80)
  order       Int           @default(0)
}

model WorkExperience {
  id        String    @id @default(cuid())
  company   String
  position  String
  location  String?
  startDate DateTime
  endDate   DateTime?
  summary   String?   @db.Text
  order     Int       @default(0)
  projects  Project[]
}

model Project {
  id               String          @id @default(cuid())
  title            String
  description      String          @db.Text
  responsibilities String[]
  techStack        String[]
  teamSize         Int?
  periodStart      DateTime?
  periodEnd        DateTime?
  imageUrl         String?
  demoUrl          String?
  repoUrl          String?
  featured         Boolean         @default(false)
  order            Int             @default(0)
  workExperience   WorkExperience? @relation(fields: [workExperienceId], references: [id], onDelete: SetNull)
  workExperienceId String?
}

model Education {
  id           String  @id @default(cuid())
  institution  String
  degree       String
  fieldOfStudy String?
  startYear    Int
  endYear      Int?
  gpa          String?
  description  String? @db.Text
  order        Int     @default(0)
}

enum CertificateKind {
  CERTIFICATE
  AWARD
}

model Certificate {
  id            String          @id @default(cuid())
  title         String
  issuer        String
  kind          CertificateKind @default(CERTIFICATE)
  issueDate     DateTime?
  credentialUrl String?
  order         Int             @default(0)
}
